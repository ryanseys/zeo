target/
.DS_Store

# Generated per-compile gem-disclosure records (zeo CLI)
zeo-gems.json

# Vendored upstream sources for the bundler north-star (not part of the build)
/vendor/

# Measurement, not source. `conformance/` holds what a sweep WROTE -- the
# gem-probe ledger is 21MB and 195,778 rows -- and none of it is an input to
# a build or a test. A refreshed ledger is attached to a GitHub release by
# hand. See docs/GEM_TESTING.md.
conformance/

# ...except the C API census, which is not measurement. `cext/stubs.rs` is
# generated from it, a unit test reads it back, and CI checks both -- so a
# fresh clone that could not see it would fail to build.
!conformance/cext-api.tsv

# Publish-time artifacts staged by `tools/zeo-dev stage-publish`; never committed.
crates/zeo/gems.pregen.tar.gz
crates/zeo/src/class_surface.pregen.rs

# Jujutsu (some of us drive git through jj; the store is local-only state)
.jj/

# Agent/editor scratch: settings, worktrees, session state
.claude/
.worktrees/
compile_flags.txt

# Local environment and logs
.env
.env.*
!.env.example
*.log

# `zeo tests/foo.rb` writes its binary to tests/foo -- the input path with the
# extension stripped. Three of those reached HEAD at 13MB each before the CI
# size guard existed. Every real file here has an extension; LICENSE is the
# one exception.
/tests/**
!/tests/**/
!/tests/**/*.*
# ...which re-includes `.DS_Store` too, since the leading dot satisfies `*.*`.
# The top-level rule cannot reach it through the negation above.
/tests/**/.DS_Store
!/tests/spinel/LICENSE
