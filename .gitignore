target/
.DS_Store

# insta's pending-snapshot droppings; `cargo insta accept` writes .snap files
# directly and nothing should ever review a .snap.new.
*.snap.new

# Generated per-compile gem-disclosure records (zeo CLI)
zeo-gems.json

# Fetched, never authored. `cargo xtask deps` writes all of it out of
# Gemfile.lock and crates/xtask/rubygems.lock: `cache/` the .gem files,
# `gems/` the store unpacked from them, `ruby/` the rubygems and bundler
# pair, `bundle/` the ruby oracle's own store. The locks are the committed
# half.
/vendor/

# Measurement, not source: what a gem-probe sweep WROTE. The ledger is 21MB
# and 195,778 rows, and nothing builds or tests against it -- a refreshed one
# is attached to a GitHub release by hand.
#
# Anything that IS an input lives in the tree as generated Rust instead
# (`cext/api.rs`, `cext/forward.rs`), so a fresh clone builds.
/measurements/

# What `gem build zeo.gemspec` leaves in the directory it ran in.
*.gem

# Publish-time artifacts staged by `cargo xtask stage-crate`; never committed.
crates/zeo/gems.pregen.tar.gz
crates/zeo/src/class_surface.pregen.rs

# Jujutsu (some of us drive git through jj; the store is local-only state)
.jj/

# Agent/editor scratch: settings, worktrees, session state
.claude/
.worktrees/
compile_flags.txt

# Local working notes (research records, follow-up plans) -- deliberately
# out of the repo.
/notes/

# Local environment and logs
.env
.env.*
!.env.example
*.log

# `zeo test/foo.rb` writes its binary to test/foo -- the input path with the
# extension stripped. Three of those reached HEAD at 13MB each before the size
# guard existed. Every real file under test/ has an extension.
/test/**
!/test/**/
!/test/**/*.*
# ...which re-includes `.DS_Store` too, since the leading dot satisfies `*.*`.
# The top-level rule cannot reach it through the negation above.
/test/**/.DS_Store
