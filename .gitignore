target/
.DS_Store

# Generated per-compile gem-disclosure records (zeo CLI)
zeo-gems.json

# Vendored upstream sources for the bundler north-star (not part of the build)
/vendor/

# The registry's gem-name index, cached by `xtask gem-probe --index`. ~3MB of
# upstream data that changes daily; `--refresh-index` takes a newer copy.
conformance/rubygems-names.txt

# Per-gem wall-clock timings from `xtask gem-probe`. Deliberately NOT
# committed: timing is not reproducible, so it would rewrite every row on
# every sweep and bury the ledger's real diff. The byte counts, which ARE
# reproducible, live in the committed ledger instead.
conformance/gem-probe-timings.tsv

# The gem-probe ledger and its rendered report. NOT committed: at 21MB and
# 11MB they break the `no tracked file over 1MB` release-hygiene gate, and
# 195,778 rows of measurement are not source. A sweep writes them locally; a
# refreshed ledger is attached to a GitHub release by hand. See
# docs/GEM_TESTING.md.
conformance/gem-probe.tsv
conformance/gem-probe.md

# Publish-time artifacts staged by `cargo xtask stage-publish`; never committed.
crates/zeo/gems.pregen.tar.gz
crates/zeo/src/class_surface.pregen.rs

# Jujutsu (some of us drive git through jj; the store is local-only state)
.jj/

# Agent/editor scratch: settings, worktrees, session state
.claude/
.worktrees/
compile_flags.txt

# Local environment and logs
.env
.env.*
!.env.example
*.log

# `zeo tests/foo.rb` writes its binary to tests/foo -- the input path with the
# extension stripped. Three of those reached HEAD at 13MB each before the CI
# size guard existed. Every real file here has an extension; LICENSE is the
# one exception.
/tests/**
!/tests/**/
!/tests/**/*.*
# ...which re-includes `.DS_Store` too, since the leading dot satisfies `*.*`.
# The top-level rule cannot reach it through the negation above.
/tests/**/.DS_Store
!/tests/spinel/LICENSE
conformance/rubygems-popular.txt
