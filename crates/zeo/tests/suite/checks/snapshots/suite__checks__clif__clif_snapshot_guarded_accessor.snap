    store notrap aligned v275, v273
    v276 = load.i64 notrap aligned v274+8
    store notrap aligned v276, v273+8
    v277 = load.i64 notrap aligned v274+16
    store notrap aligned v277, v273+16
    v278 = stack_addr.i64 ss9
    v279 = iconst.i64 1
    v280 = stack_addr.i64 ss7
    v281 = call fn20(v278, v279, v280)  ; v279 = 1
    brif v281, block1, block70

block70:
    v282 = load.i64 notrap aligned v8+24
    v283 = load.i64 notrap aligned v8+32
    v284 = isub v282, v283
    v285 = iconst.i64 24
    v286 = udiv v284, v285  ; v285 = 24
    v287 = icmp ugt v286, v229
    brif v287, block71, block72

block71 cold:
    call fn10(v229)
    jump block72

block72:
    v289 = iconst.i64 0
    store notrap aligned v289, v0  ; v289 = 0
    store notrap aligned v289, v0+8  ; v289 = 0
    store notrap aligned v289, v0+16  ; v289 = 0
    v290 = iconst.i32 0
    jump block73(v290)  ; v290 = 0

block1:
    v291 = iconst.i32 1
    jump block73(v291)  ; v291 = 1

block73(v288: i32):
    v292 = stack_addr.i64 ss0
    v293 = load.i8 notrap aligned v292
    v294 = iconst.i8 16
    v295 = icmp uge v293, v294  ; v294 = 16
    brif v295, block74, block75

block74:
    call fn12(v292)
    jump block75

block75:
    v296 = symbol_value.i64 gv2
    v297 = load.i16 notrap aligned v296
    v298 = iconst.i16 512
    v299 = band v297, v298  ; v298 = 512
    brif v299, block76, block77

block76 cold:
    call fn22()
    jump block78

block77:
    v300 = load.i64 notrap aligned v8
    v301 = load.i64 notrap aligned v8+8
    v302 = icmp eq v300, v301
    brif v302, block78, block79

block79:
    v303 = iconst.i64 -48
    v304 = iadd.i64 v300, v303  ; v303 = -48
    store notrap aligned v304, v8
    v305 = load.i32 notrap aligned v304+40
    v306 = iconst.i32 -1
    v307 = icmp eq v305, v306  ; v306 = -1
    brif v307, block78, block80

block80:
    v308 = load.i64 notrap aligned v8+24
    v309 = load.i64 notrap aligned v8+32
    v310 = isub v308, v309
    v311 = iconst.i64 24
    v312 = udiv v310, v311  ; v311 = 24
    v313 = uextend.i64 v305
    v314 = icmp ugt v312, v313
    brif v314, block81, block78

block81 cold:
    call fn10(v313)
    jump block78

block78:
    return v288
}

;; zeo_unit_init
function %zeo_unit_init() ccall {
    gv0 = symbol colocated %zeo_sym_rows
    gv1 = symbol colocated %zeo_callsite_callers
    gv2 = symbol colocated %zeo_syms
    gv3 = symbol colocated %zeo_callsites
    gv4 = symbol colocated %zeo_cm_sites
    gv5 = symbol colocated %zeo_const_sites
    gv6 = symbol colocated %zeo_new_sites
    gv7 = symbol colocated %zeo_dyn_sites
    sig0 = (i64, i64, i64) ccall
    sig1 = (i64, i64, i64) ccall
    sig2 = (i64, i64) ccall
    sig3 = (i64, i64) ccall
    sig4 = (i64, i64) ccall
    sig5 = (i64, i64) ccall
    fn0 = %zeo_rt_syms_init sig0
    fn1 = %zeo_rt_callsites_init sig1
    fn2 = %zeo_rt_cm_sites_init sig2
    fn3 = %zeo_rt_const_sites_init sig3
    fn4 = %zeo_rt_class_new_sites_init sig4
    fn5 = %zeo_rt_dyncaller_sites_init sig5

block0:
    v0 = symbol_value.i64 gv0
    v1 = iconst.i64 5
    v2 = symbol_value.i64 gv2
    call fn0(v0, v1, v2)  ; v1 = 5
    v3 = symbol_value.i64 gv3
    v4 = symbol_value.i64 gv1
    v5 = iconst.i64 4
    call fn1(v3, v4, v5)  ; v5 = 4
    v6 = symbol_value.i64 gv6
    v7 = iconst.i64 1
    call fn4(v6, v7)  ; v7 = 1
    v8 = symbol_value.i64 gv7
    v9 = iconst.i64 1
    call fn5(v8, v9)  ; v9 = 1
    return
}

;; main
function %main(i32, i64) -> i32 ccall {
    gv0 = symbol colocated %zeo_program_desc
    sig0 = (i32, i64, i64) -> i32 ccall
    fn0 = %zeo_rt_main sig0

block0(v0: i32, v1: i64):
    v2 = symbol_value.i64 gv0
    v3 = call fn0(v0, v1, v2)
    return v3
}
