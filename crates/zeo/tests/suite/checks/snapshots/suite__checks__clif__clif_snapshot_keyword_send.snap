    call fn5(v89)
    jump block20

block20:
    v93 = load.i64 notrap aligned v8+24
    v94 = load.i64 notrap aligned v8+32
    v95 = isub v93, v94
    v96 = iconst.i64 24
    v97 = udiv v95, v96  ; v96 = 24
    v98 = icmp ugt v97, v57
    brif v98, block21, block22

block21 cold:
    call fn12(v57)
    jump block22

block22:
    v99 = load.i64 notrap aligned v8+24
    v100 = load.i64 notrap aligned v8+32
    v101 = isub v99, v100
    v102 = iconst.i64 24
    v103 = udiv v101, v102  ; v102 = 24
    v104 = iconst.i32 5
    v105 = symbol_value.i64 gv2
    v106 = load.i16 notrap aligned v105
    v107 = iconst.i16 512
    v108 = band v106, v107  ; v107 = 512
    brif v108, block23, block24

block23 cold:
    call fn8(v104)  ; v104 = 5
    jump block25

block24:
    v109 = load.i64 notrap aligned v8
    v110 = load.i64 notrap aligned v8+8
    v111 = icmp eq v109, v110
    brif v111, block25, block26

block26:
    store.i32 notrap aligned v104, v109-16  ; v104 = 5
    jump block25

block25:
    v112 = iconst.i64 4
    v113 = stack_addr.i64 ss9
    v114 = iconst.i8 2
    store notrap aligned v114, v113  ; v114 = 2
    store notrap aligned v112, v113+8  ; v112 = 4
    v115 = stack_addr.i64 ss9
    v116 = load.i32 notrap aligned v2+8
    v117 = iconst.i32 0
    v118 = iconst.i64 1
    v119 = iconst.i64 0
    v120 = stack_addr.i64 ss8
    v121 = symbol_value.i64 gv5
    v122 = iconst.i64 112
    v123 = iadd v121, v122  ; v122 = 112
    v124 = call fn13(v123, v117, v29, v116, v115, v118, v119, v120)  ; v117 = 0, v118 = 1, v119 = 0
    brif v124, block1, block27

block27:
    v125 = stack_addr.i64 ss8
    v126 = load.i8 notrap aligned v125
    v127 = iconst.i8 16
    v128 = icmp uge v126, v127  ; v127 = 16
    brif v128, block28, block29

block28:
    call fn5(v125)
    jump block29

block29:
    v129 = load.i64 notrap aligned v8+24
    v130 = load.i64 notrap aligned v8+32
    v131 = isub v129, v130
    v132 = iconst.i64 24
    v133 = udiv v131, v132  ; v132 = 24
    v134 = icmp ugt v133, v103
    brif v134, block30, block31

block30 cold:
    call fn12(v103)
    jump block31

block31:
    v136 = iconst.i64 0
    store notrap aligned v136, v0  ; v136 = 0
    store notrap aligned v136, v0+8  ; v136 = 0
    store notrap aligned v136, v0+16  ; v136 = 0
    v137 = iconst.i32 0
    jump block32(v137)  ; v137 = 0

block1:
    v138 = iconst.i32 1
    jump block32(v138)  ; v138 = 1

block32(v135: i32):
    v139 = symbol_value.i64 gv2
    v140 = load.i16 notrap aligned v139
    v141 = iconst.i16 512
    v142 = band v140, v141  ; v141 = 512
    brif v142, block33, block34

block33 cold:
    call fn14()
    jump block35

block34:
    v143 = load.i64 notrap aligned v8
    v144 = load.i64 notrap aligned v8+8
    v145 = icmp eq v143, v144
    brif v145, block35, block36

block36:
    v146 = iconst.i64 -48
    v147 = iadd.i64 v143, v146  ; v146 = -48
    store notrap aligned v147, v8
    v148 = load.i32 notrap aligned v147+40
    v149 = iconst.i32 -1
    v150 = icmp eq v148, v149  ; v149 = -1
    brif v150, block35, block37

block37:
    v151 = load.i64 notrap aligned v8+24
    v152 = load.i64 notrap aligned v8+32
    v153 = isub v151, v152
    v154 = iconst.i64 24
    v155 = udiv v153, v154  ; v154 = 24
    v156 = uextend.i64 v148
    v157 = icmp ugt v155, v156
    brif v157, block38, block35

block38 cold:
    call fn12(v156)
    jump block35

block35:
    return v135
}

;; zeo_unit_init
function %zeo_unit_init() ccall {
    gv0 = symbol colocated %zeo_sym_rows
    gv1 = symbol colocated %zeo_callsite_callers
    gv2 = symbol colocated %zeo_syms
    gv3 = symbol colocated %zeo_callsites
    gv4 = symbol colocated %zeo_cm_sites
    gv5 = symbol colocated %zeo_const_sites
    gv6 = symbol colocated %zeo_new_sites
    gv7 = symbol colocated %zeo_dyn_sites
    sig0 = (i64, i64, i64) ccall
    sig1 = (i64, i64, i64) ccall
    sig2 = (i64, i64) ccall
    sig3 = (i64, i64) ccall
    sig4 = (i64, i64) ccall
    sig5 = (i64, i64) ccall
    fn0 = %zeo_rt_syms_init sig0
    fn1 = %zeo_rt_callsites_init sig1
    fn2 = %zeo_rt_cm_sites_init sig2
    fn3 = %zeo_rt_const_sites_init sig3
    fn4 = %zeo_rt_class_new_sites_init sig4
    fn5 = %zeo_rt_dyncaller_sites_init sig5

block0:
    v0 = symbol_value.i64 gv0
    v1 = iconst.i64 3
    v2 = symbol_value.i64 gv2
    call fn0(v0, v1, v2)  ; v1 = 3
    v3 = symbol_value.i64 gv3
    v4 = symbol_value.i64 gv1
    v5 = iconst.i64 3
    call fn1(v3, v4, v5)  ; v5 = 3
    return
}

;; main
function %main(i32, i64) -> i32 ccall {
    gv0 = symbol colocated %zeo_program_desc
    sig0 = (i32, i64, i64) -> i32 ccall
    fn0 = %zeo_rt_main sig0

block0(v0: i32, v1: i64):
    v2 = symbol_value.i64 gv0
    v3 = call fn0(v0, v1, v2)
    return v3
}
