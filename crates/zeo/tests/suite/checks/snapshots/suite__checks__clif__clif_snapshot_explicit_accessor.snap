    jump block12

block12:
    v44 = iconst.i64 19
    v45 = iadd.i64 v1, v44  ; v44 = 19
    v46 = iconst.i64 16
    v47 = iconst.i64 13
    v48 = iadd.i64 v1, v47  ; v47 = 13
    v49 = iconst.i64 6
    v50 = iconst.i32 0
    v51 = iconst.i32 0
    v52 = iconst.i32 0
    call fn7(v50, v45, v46, v40, v48, v49, v51, v52)  ; v50 = 0, v46 = 16, v49 = 6, v51 = 0, v52 = 0
    v53 = load.i64 notrap aligned v8+24
    v54 = load.i64 notrap aligned v8+32
    v55 = isub v53, v54
    v56 = iconst.i64 24
    v57 = udiv v55, v56  ; v56 = 24
    v58 = iconst.i32 1
    v59 = symbol_value.i64 gv2
    v60 = load.i16 notrap aligned v59
    v61 = iconst.i16 512
    v62 = band v60, v61  ; v61 = 512
    brif v62, block13, block14

block13 cold:
    call fn8(v58)  ; v58 = 1
    jump block15

block14:
    v63 = load.i64 notrap aligned v8
    v64 = load.i64 notrap aligned v8+8
    v65 = icmp eq v63, v64
    brif v65, block15, block16

block16:
    store.i32 notrap aligned v58, v63-16  ; v58 = 1
    jump block15

block15:
    v66 = iconst.i32 0
    v67 = iconst.i64 35
    v68 = iadd.i64 v1, v67  ; v67 = 35
    v69 = iconst.i64 4
    v70 = iconst.i64 2
    v71 = iconst.i32 1
    call fn9(v66, v68, v69, v1, v70, v71)  ; v66 = 0, v69 = 4, v70 = 2, v71 = 1
    v72 = load.i64 notrap aligned v8+24
    v73 = load.i64 notrap aligned v8+32
    v74 = isub v72, v73
    v75 = iconst.i64 24
    v76 = udiv v74, v75  ; v75 = 24
    v77 = icmp ugt v76, v57
    brif v77, block17, block18

block17 cold:
