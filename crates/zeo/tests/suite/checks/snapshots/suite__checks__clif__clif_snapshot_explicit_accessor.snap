block18:
    v78 = load.i64 notrap aligned v8+24
    v79 = load.i64 notrap aligned v8+32
    v80 = isub v78, v79
    v81 = iconst.i64 24
    v82 = udiv v80, v81  ; v81 = 24
    v83 = iconst.i32 10
    v84 = symbol_value.i64 gv2
    v85 = load.i16 notrap aligned v84
    v86 = iconst.i16 512
    v87 = band v85, v86  ; v86 = 512
    brif v87, block19, block20

block19 cold:
    call fn8(v83)  ; v83 = 10
    jump block21

block20:
    v88 = load.i64 notrap aligned v8
    v89 = load.i64 notrap aligned v8+8
    v90 = icmp eq v88, v89
    brif v90, block21, block22

block22:
    store.i32 notrap aligned v83, v88-16  ; v83 = 10
