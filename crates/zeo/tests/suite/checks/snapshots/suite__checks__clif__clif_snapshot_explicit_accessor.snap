    v9 = symbol_value.i64 gv2
    v10 = load.i16 notrap aligned v9
    v11 = iconst.i16 512
    v12 = band v10, v11  ; v11 = 512
    brif v12, block2, block3

block2 cold:
    v13 = call fn1(v1, v3, v5, v6, v7, v7)  ; v3 = 2, v6 = 6, v7 = 0, v7 = 0
    brif v13, block1, block5

block5:
    jump block4

block3:
    v14 = load.i64 notrap aligned v8
    v15 = load.i64 notrap aligned v8+16
    v16 = icmp eq v14, v15
    brif v16, block6, block7

block6 cold:
    call fn2(v1, v3, v5, v6, v7, v7)  ; v3 = 2, v6 = 6, v7 = 0, v7 = 0
    jump block8

block7:
    store.i64 notrap aligned v1, v14
    store.i64 notrap aligned v3, v14+8  ; v3 = 2
    store.i64 notrap aligned v5, v14+16
    store.i64 notrap aligned v6, v14+24  ; v6 = 6
    store.i32 notrap aligned v7, v14+32  ; v7 = 0
    store.i32 notrap aligned v7, v14+36  ; v7 = 0
    v17 = load.i64 notrap aligned v8+24
    v18 = load.i64 notrap aligned v8+32
    v19 = isub v17, v18
    v20 = iconst.i64 24
    v21 = udiv v19, v20  ; v20 = 24
    v22 = ireduce.i32 v21
    store notrap aligned v22, v14+40
    v23 = iconst.i32 0
    store notrap aligned v23, v14+44  ; v23 = 0
    v24 = iconst.i64 48
    v25 = iadd.i64 v14, v24  ; v24 = 48
    store notrap aligned v25, v8
    jump block8

block8:
    v26 = symbol_value.i64 gv3
    v27 = load.i32 notrap aligned v26
    brif v27, block9, block10

block9 cold:
    v28 = call fn3()
    brif v28, block1, block10

block10:
    jump block4

block4:
    v29 = stack_addr.i64 ss0
    call fn4(v29)
    call fn5(v29)
    v30 = stack_addr.i64 ss1
    v31 = iconst.i64 0
    v32 = stack_addr.i64 ss2
    v33 = iconst.i64 13
    v34 = iadd.i64 v1, v33  ; v33 = 13
    v35 = iconst.i64 6
    v36 = iconst.i32 0
    v37 = iconst.i32 0
    v38 = iconst.i32 -1
    v39 = stack_addr.i64 ss3
    call fn6(v29, v30, v32, v31, v34, v35, v36, v37, v38, v39)  ; v31 = 0, v35 = 6, v36 = 0, v37 = 0, v38 = -1
    v40 = stack_addr.i64 ss3
    v41 = load.i8 notrap aligned v40
    v42 = iconst.i8 16
    v43 = icmp uge v41, v42  ; v42 = 16
    brif v43, block11, block12

block11:
