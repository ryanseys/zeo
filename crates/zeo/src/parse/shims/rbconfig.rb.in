# frozen_string_literal: true
#
# Synthesized `rbconfig` shim, built into zeo (spliced by parse/loader.rs when a
# program `require`s "rbconfig"). Real Ruby generates rbconfig.rb at build time
# from its own build configuration; zeo has no such build, so build.rs renders
# this template with the BUILD TARGET's platform facts (@..@ placeholders,
# substituted from CARGO_CFG_TARGET_*). It carries the keys rubygems + bundler
# actually read (version, platform, install layout).
#
# REMAINING LIMITATION: the install prefix is a synthesized FHS default, not a
# real install layout -- if bundler/rubygems behavior ever keys off the real
# install dirs, the prefix needs runtime substitution from the resolved home
# (zeo::home), not a compile-time constant.
module RbConfig
  ruby_version = "4.0.0"
  prefix = "/usr/local"
  arch = "@RUBY_PLATFORM@"

  # Where `crates/zeo-rt/cext/` landed. `zeo` exports these before it runs an
  # `extconf.rb`; the fallbacks are the dev tree.
  hdrdir = ENV["ZEO_CEXT_HDRDIR"] || "@CEXT_HDRDIR@"
  archhdrdir = ENV["ZEO_CEXT_ARCHHDRDIR"] || "@CEXT_ARCHHDRDIR@"

  CONFIG = {
    "MAJOR" => "4",
    "MINOR" => "0",
    "TEENY" => "0",
    "PATCHLEVEL" => "5",
    "ruby_version" => ruby_version,
    "RUBY_SO_NAME" => "ruby.4.0",
    "ruby_install_name" => "ruby",
    "RUBY_INSTALL_NAME" => "ruby",
    "RUBY_BASE_NAME" => "ruby",

    # Platform / host triple.
    "arch" => arch,
    "sitearch" => arch,
    "platform" => "@HOST_TRIPLE@",
    "host" => "@HOST_TRIPLE@",
    "host_alias" => "",
    "host_cpu" => "@HOST_CPU@",
    "host_vendor" => "@HOST_VENDOR@",
    "host_os" => "@HOST_OS@",
    "target" => "@HOST_TRIPLE@",
    "target_cpu" => "@HOST_CPU@",
    "target_vendor" => "@HOST_VENDOR@",
    "target_os" => "@HOST_OS@",

    # Executable / shared-object extensions.
    "EXEEXT" => "",
    "EXECUTABLE_EXTS" => "",
    "DLEXT" => "@DLEXT@",
    "SOEXT" => "@SOEXT@",
    "LIBEXT" => "a",
    "OBJEXT" => "o",

    # Install layout (prefix-relative; a synthesized default, not a real build).
    "prefix" => prefix,
    "exec_prefix" => prefix,
    "bindir" => "#{prefix}/bin",
    "libdir" => "#{prefix}/lib",
    "rubylibprefix" => "#{prefix}/lib/ruby",
    "rubylibdir" => "#{prefix}/lib/ruby/#{ruby_version}",
    "archdir" => "#{prefix}/lib/ruby/#{ruby_version}/#{arch}",
    "sitedir" => "#{prefix}/lib/ruby/site_ruby",
    "sitelibdir" => "#{prefix}/lib/ruby/site_ruby/#{ruby_version}",
    "sitearchdir" => "#{prefix}/lib/ruby/site_ruby/#{ruby_version}/#{arch}",
    "vendordir" => "#{prefix}/lib/ruby/vendor_ruby",
    "vendorlibdir" => "#{prefix}/lib/ruby/vendor_ruby/#{ruby_version}",
    "vendorarchdir" => "#{prefix}/lib/ruby/vendor_ruby/#{ruby_version}/#{arch}",
    "sysconfdir" => "/etc",
    "mandir" => "#{prefix}/share/man",
    "datadir" => "#{prefix}/share",
    "localstatedir" => "/var",

    # Feature flags rubygems consults.
    "ENABLE_SHARED" => "yes",
    "host_os_version" => "@OS_VERSION@",
    "CC" => ENV["CC"] || "cc",
    "CXX" => ENV["CXX"] || "c++",
    "LD" => ENV["LD"] || "ld",
    "AR" => "ar",
    "LDSHARED" => "@LDSHARED@",
    "DLDFLAGS" => "",
    "configure_args" => "",

    # --- The keys `mkmf` reads. -------------------------------------------
    #
    # zeo has no build tree, so the header directories are where the INSTALL
    # put `crates/zeo-rt/cext/`. That is a run-time fact, not a compile-time
    # one, so `zeo` exports it before it runs an `extconf.rb`; the fallback is
    # the dev tree, which is where it is during development.
    "topdir" => hdrdir,
    "hdrdir" => hdrdir,
    "rubyhdrdir" => hdrdir,
    "rubyarchhdrdir" => archhdrdir,
    "srcdir" => ".",
    "build_os" => "@HOST_OS@",
    "GCC" => "yes",
    "CC_WRAPPER" => "",
    "CCDLFLAGS" => "-fPIC",
    "CSRCFLAG" => "",
    "COUTFLAG" => "-o ",
    "OUTFLAG" => "-o ",
    "CPPOUTFILE" => "-o conftest.i",
    "PATH_SEPARATOR" => ":",
    "NULLCMD" => ":",
    "MKMF_VERBOSE" => "0",
    "DEFS" => "",
    "DLDLIBS" => "",
    "EXTDLDFLAGS" => "",
    "LIBRUBY" => "",
    "LIBRUBY_A" => "",
    "LIBRUBYARG" => "",
    "LIBRUBYARG_SHARED" => "",
    "LIBRUBYARG_STATIC" => "",
    "LIBS" => "-lm -lpthread",
    "SOLIBS" => "",
    "cflags" => "$(optflags) $(debugflags) $(warnflags)",
    "cxxflags" => "$(optflags) $(debugflags) $(warnflags)",
    "cppflags" => "",
    "optflags" => "-O2",
    "debugflags" => "-g",
    "warnflags" => "-Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers",
    "CFLAGS" => "$(cflags) -fPIC",
    "CXXFLAGS" => "$(cxxflags) -fPIC",
    "CPPFLAGS" => "$(DEFS) $(cppflags)",
    "LDFLAGS" => "",
    "ARCH_FLAG" => "",
    "STRIP" => "strip -A -n",
    "TRY_LINK" => "",
    "COMMON_HEADERS" => "",
    "COMMON_MACROS" => "",
    "COMMON_LIBS" => "",
    "RUBY_PROGRAM_VERSION" => ruby_version,
    "UNIVERSAL_ARCHNAMES" => "",
    "universal" => "",
  }

  # `MAKEFILE_CONFIG`'s values keep their `$(var)` references: mkmf writes
  # them into the Makefile verbatim, and `make` is what expands them. `CONFIG`
  # is the same table with every reference already resolved, which is what
  # `expand` below does.
  MAKEFILE_CONFIG = CONFIG.dup
  TOPDIR = CONFIG["topdir"]

  # `RbConfig.ruby` -- the full path to the running interpreter.
  def self.ruby
    File.join(CONFIG["bindir"], CONFIG["ruby_install_name"] + CONFIG["EXEEXT"])
  end

  # Substitute `$(var)` and `$$` references, as real rbconfig does. mkmf
  # depends on this: `CFLAGS` is `$(cflags) -fPIC` and `cflags` is three more
  # references, and an unexpanded one reaches the compiler as a literal.
  #
  # A reference to a key that is not here expands to the empty string, which
  # is what real rbconfig does for an unset one.
  def self.expand(val, config = CONFIG)
    return val unless val.is_a?(String)

    10.times do
      before = val
      val = val.gsub(/\$\((\w+)\)/) { config[Regexp.last_match(1)] || "" }
      break if val == before
    end
    val.gsub("$$", "$")
  end
end

# Resolve every `$(var)` in `CONFIG` itself. `MAKEFILE_CONFIG` keeps them.
RbConfig::CONFIG.each_key do |k|
  RbConfig::CONFIG[k] = RbConfig.expand(RbConfig::CONFIG[k], RbConfig::CONFIG)
end
RbConfig::CONFIG.freeze
