# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.rs]
indent_size = 4

[*.{rb,gemspec,yml,yaml,toml,json}]
indent_size = 2

[Gemfile]
indent_size = 2

# The corpus records answers byte for byte, and a fixture is whatever bytes
# it needs to be. Nothing here may rewrite one.
[test/**]
trim_trailing_whitespace = false
insert_final_newline = false
