["[a-\\d]", :RegexpError]
["[\\d-z]", :RegexpError]
["[\\w-z]", :RegexpError]
["[a-\\w]", :RegexpError]
["[\\d-9]", :RegexpError]
["[[:alpha:]-z]", :RegexpError]
["[\\s-z]", :RegexpError]
["[^\\d-z]", :RegexpError]
["[-\\w]", ["-", "a", "5"]]
["[\\w-]", ["-", "a", "5"]]
["[-\\d-]", ["-", "5"]]
["[[:alpha:]-]", ["a", "-"]]
["[-[:digit:]]", ["-", "5"]]
["[\\d\\-z]", ["0", "-", "z"]]
["[-a]", ["-", "a"]]
["[a-]", ["-", "a"]]
["[a-z]", ["a", "m", "z"]]
["[0-9\\w]", ["0", "a"]]
["[\\w0-9]", ["0", "a"]]
["[\\d\\w]", ["0", "a"]]
["[[:alpha:]_]", ["a", "_"]]
["[^\\w-]", ["!"]]
