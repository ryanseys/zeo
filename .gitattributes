# Generated Rust: each file names its generator in its module header and
# says "do not edit". linguist-generated collapses them in GitHub diffs and
# keeps them out of language stats; a change to one should be reviewed as
# "the generator or its input moved", not line by line.
crates/zeo-rt/src/cext/api.rs linguist-generated
crates/zeo-rt/src/cext/stubs.rs linguist-generated
crates/zeo-rt/src/cext/forward.rs linguist-generated
crates/zeo-rt/src/enc/registry.rs linguist-generated
crates/zeo-rt/src/enc/single_byte.rs linguist-generated
crates/zeo-rt/src/enc/casefold.rs linguist-generated
crates/zeo-rt/src/enc/printable.rs linguist-generated

# The corpus is thousands of small Ruby programs and the extensions carry
# their Ruby halves, some vendored from upstream gems (see
# crates/zeo-rt/ext/UPSTREAM.md). Neither is what the repository is written
# in, so both stay out of the language statistics.
test/** linguist-vendored
crates/zeo-rt/ext/*/lib/** linguist-vendored
crates/zeo-rt/gems/** linguist-vendored
